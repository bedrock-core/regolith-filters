{
	"name": "@bedrock-core/regolith-filters",
	"version": "0.0.0",
	"private": true,
	"description": "Type checking for the Bedrock Core Regolith filter set. Filters run their TypeScript directly on Node; nothing here is emitted or shipped.",
	"workspaces": [
		"bundler",
		"core",
		"generator",
		"guides",
		"i18n",
		"manifest",
		"ui-compiler"
	],
	"scripts": {
		"typecheck": "tsc",
		"clean": "node scripts/clean.mjs",
		"test": "vitest run",
		"changeset": "changeset",
		"lock": "node scripts/lock-filters.mjs",
		"version-packages": "changeset version && node scripts/lock-filters.mjs",
		"release": "node scripts/tag-filters.mjs"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@types/node": "^24.3.0",
		"@types/picomatch": "^4.0.3",
		"typescript": "^5.9.2",
		"vitest": "^4.1.5"
	}
}
